# Configure these only in the deployment environment; never prefix them with NEXT_PUBLIC_.
EXIT_OFFER_HMAC_SECRET=replace-with-a-long-random-secret
EXIT_OFFER_RATE_LIMIT_SECRET=replace-with-a-second-long-random-secret
# Choose either or both of the approved delivery methods. Leave blank until Kiwify is configured.
COUPON_CODE=
DISCOUNT_CHECKOUT_URL=
# Optional client-side reappearance period (1-90 days; default 7).
EXIT_OFFER_SUPPRESSION_DAYS=7
