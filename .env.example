# Configure these only in the deployment environment; never prefix them with NEXT_PUBLIC_.
EXIT_OFFER_HMAC_SECRET=replace-with-a-long-random-secret
EXIT_OFFER_RATE_LIMIT_SECRET=replace-with-a-second-long-random-secret
# Required in Vercel: provision Upstash Redis through the Vercel Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional but recommended separate secret used to encrypt lead fields at rest.
EXIT_OFFER_LEAD_ENCRYPTION_SECRET=
# Retention for encrypted leads (1-365 days; default 180).
EXIT_OFFER_LEAD_RETENTION_DAYS=180
# Password for the private /leads area. Use at least 12 characters.
EXIT_OFFER_ADMIN_PASSWORD=replace-with-a-private-admin-password
# Choose either or both of the approved delivery methods. Leave blank until Kiwify is configured.
COUPON_CODE=
DISCOUNT_CHECKOUT_URL=
# Optional client-side reappearance period (1-90 days; default 7).
EXIT_OFFER_SUPPRESSION_DAYS=7

# SEO: endereço já publicado. Trocar SOMENTE ao conectar o domínio definitivo.
SITE_URL=https://samanatatiktokshop.vercel.app
# TODO: inserir o Measurement ID real do fluxo Web do GA4 (G-XXXXXXXXXX).
GOOGLE_ANALYTICS_ID=
# TODO: inserir o Project ID real do Microsoft Clarity (não a URL do painel).
MICROSOFT_CLARITY_ID=
# TODO: inserir apenas o content da meta tag de verificação do Search Console.
GOOGLE_SITE_VERIFICATION=
# Analytics só carrega após consentimento explícito da CMP.
# TODO: integrar sua CMP a window.sunlixSetAnalyticsConsent(true/false).
# O checkbox de novidades do formulário NÃO autoriza cookies de analytics.
